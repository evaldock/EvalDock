    "/api/v1/dsh": {
      "get": {
        "summary": "Read actual DSH status and stable Agent identity",
        "responses": {
          "200": {
            "description": "Current state / results"
          },
          "409": {
            "description": "DSH is busy or operation failed"
          }
        }
      }
    },
    "/api/v1/dsh/control": {
      "post": {
        "summary": "Start, stop or restart actual DSH; 409 while a test or session is active",
        "responses": {
          "200": {
            "description": "Current state / results"
          },
          "409": {
            "description": "DSH is busy or operation failed"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "enum": [
                      "start",
                      "stop",
                      "restart"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/dsh/plugins": {
      "post": {
        "summary": "Activate exact optional plugin set and restart the actual Web profile",
        "responses": {
          "200": {
            "description": "Current state / results"
          },
          "409": {
            "description": "DSH is busy or operation failed"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "plugins"
                ],
                "properties": {
                  "plugins": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "string",
                      "maxLength": 256
                    },
                    "description": "Exact active optional plugin set. Omit to keep current; [] selects base/Web only."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/dsh/plugins/search": {
      "get": {
        "summary": "Search the existing evaldock.ai plugin catalog",
        "responses": {
          "200": {
            "description": "Current state / results"
          },
          "409": {
            "description": "DSH is busy or operation failed"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "StartJob": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "targetId"
        ],
        "properties": {
          "action": {
            "enum": [
              "inspect",
              "plan",
              "run"
            ]
          },
          "targetId": {
            "type": "string"
          },
          "caseId": {
            "type": "string",
            "description": "run only; use result.caseQueue ID, not a dataset folder"
          },
          "maxCases": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "stopAfterCase": {
            "type": "boolean"
          },
          "fixtureBehavior": {
            "enum": [
              "success",
              "bad-output",
              "insufficient-probe",
              "reset-mismatch"
            ]
          },
          "datasetCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "description": "Exact number of Datasets requested from Planner"
          },
          "casesPerDataset": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "plugins": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "maxLength": 256
            },
            "description": "Exact active optional plugin set. Omit to keep current; [] selects base/Web only."
          },
          "caseCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "description": "Exact total number of Cases across selected Datasets"
          }
        }
      },
      "Job": {
        "type": "object",
        "required": [
          "id",
          "runId",
          "action",
          "state",
          "summary",
          "links"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "runId": {
            "type": "string"
          },
          "action": {
            "enum": [
              "inspect",
              "plan",
              "run"
            ]
          },
          "state": {
            "enum": [
              "STARTING",
              "RUNNING",
              "CANCELLING",
              "SUCCEEDED",
              "FAILED",
              "CANCELLED",
              "INTERRUPTED"
            ]
          },
          "targetId": {
            "type": "string"
          },
          "summary": {
            "type": [
              "object",
              "null"
            ]
          },
          "exitCode": {
            "type": [
              "integer",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "links": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "Events": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sequence": {
                  "type": "integer"
                },
                "time": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "state",
                    "stdout",
                    "stderr",
                    "error",
                    "warning"
                  ]
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "nextCursor": {
            "type": "integer"
          },
          "gap": {
            "type": "boolean"
          },
          "state": {
            "type": "string"
          }
        }
      },
      "JobResult": {
        "type": "object",
        "properties": {
          "summary": {
            "type": [
              "object",
              "null"
            ]
          },
          "inspection": {
            "type": [
              "object",
              "null"
            ]
          },
          "evaluationPlan": {
            "type": [
              "object",
              "null"
            ]
          },
          "caseQueue": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "datasetId": {
                  "type": "string"
                },
                "caseIndex": {
                  "type": "integer"
                },
                "caseId": {
                  "type": "string"
                }
              }
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
