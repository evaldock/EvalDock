{
  "name": "evaldock-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "evaldock": "./dist/src/app/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "compatibility": "node adapters/compatibility/cli.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('src/agent-trace/native-probe/lib',{recursive:true,force:true})\"",
    "build:probe": "tsc -p src/agent-trace/native-probe/tsconfig.json",
    "build": "pnpm run clean && pnpm run build:probe && tsc -p tsconfig.json",
    "check": "tsc -p src/agent-trace/native-probe/tsconfig.json --noEmit && tsc -p tsconfig.json --noEmit",
    "cli": "node dist/src/app/cli.js",
    "test": "pnpm run build && node --test tests/contracts/*.test.mjs",
    "verify": "node scripts/check-publication-boundary.mjs && pnpm run test:benchdock-import && pnpm run check && pnpm test",
    "workbench": "node workbench/control-server.mjs",
    "test:benchdock-import": "python3 -m unittest discover -s tests -p test_benchdock_import.py",
    "desktop:prepare": "pnpm run build && node scripts/stage-desktop.mjs",
    "desktop": "pnpm run desktop:prepare && electron .",
    "desktop:pack": "pnpm run desktop:prepare && electron-builder --mac --dir",
    "desktop:dmg": "pnpm run desktop:prepare && electron-builder --mac dmg"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "22.18.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "5.9.3"
  },
  "main": "desktop/main.mjs",
  "build": {
    "appId": "ai.evaldock.desktop",
    "productName": "EvalDock",
    "directories": {
      "output": "artifacts/mac"
    },
    "files": [
      "desktop/main.mjs",
      "desktop/preload.cjs",
      "desktop/workspace.mjs",
      "package.json",
      "desktop/assets/icon.png"
    ],
    "extraResources": [
      {
        "from": "artifacts/desktop-runtime",
        "to": "runtime"
      },
      {
        "from": "artifacts/desktop-runtime/node_modules",
        "to": "runtime/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "identity": "-",
      "icon": "desktop/assets/icon.icns"
    },
    "afterPack": "scripts/verify-desktop-package.cjs",
    "dmg": {
      "icon": "desktop/assets/icon.icns"
    },
    "afterSign": "scripts/verify-desktop-signature.cjs"
  },
  "description": "Local desktop evaluation for agents and plugins",
  "dependencies": {
    "undici": "7.30.0"
  }
}
